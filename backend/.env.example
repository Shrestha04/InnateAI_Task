# Free Mapillary client token — sign up (no credit card) at
# https://www.mapillary.com/dashboard/developers, create an app, copy its
# "Client Token" (starts with MLY|...).
MAPILLARY_TOKEN=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional overrides — defaults target central London. Venue discovery uses
# OpenStreetMap Overpass + Nominatim, which need no API key at all.
# SEARCH_LAT=51.5074
# SEARCH_LNG=-0.1278
# SEARCH_RADIUS_M=4000
